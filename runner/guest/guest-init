#!/bin/sh
set -eu

ensure_mounted() {
  target="$1"
  filesystem="$2"
  source="$3"
  if findmnt -rn -T "$target" -o FSTYPE | grep -qx "$filesystem"; then
    return 0
  fi
  mount -t "$filesystem" "$source" "$target"
  findmnt -rn -T "$target" -o FSTYPE | grep -qx "$filesystem"
}

ensure_mounted /proc proc proc
ensure_mounted /sys sysfs sysfs
ensure_mounted /dev devtmpfs devtmpfs
mount -o ro /dev/vdb /input
mount /dev/vdc /output
mkdir -p /output/traces /output/work
chmod 0700 /output/traces /output/work
chown 65532:65532 /output/work

/opt/venv/bin/python /opt/shakerscan/guest_worker.py --inventory > /output/interfaces.json
status=0
mode="$(/opt/venv/bin/python -c 'import json; print(json.load(open("/input/job.json"))["mode"])')"
if [ "$mode" = "runtime" ]; then
  phases="import tokenizer model_load warmup inference teardown"
elif [ "$mode" = "conversion" ]; then
  phases="import deserialize_convert tensor_equivalence embedding_equivalence teardown"
else
  phases="invalid"
  status=64
fi
for phase in $phases; do
  [ "$status" -eq 0 ] || break
  /usr/bin/strace -ff -tt -T -s 256 -yy \
    -e trace=%network,execve,openat,clone,fork,vfork \
    -o "/output/traces/trace.${phase}" \
    /usr/bin/setpriv --reuid=65532 --regid=65532 --clear-groups \
    /opt/venv/bin/python /opt/shakerscan/guest_worker.py --phase "$phase" || status=$?
  [ "$status" -eq 0 ] || break
done
/opt/venv/bin/python /opt/shakerscan/guest_worker.py --finalize "$status"
sync
/bin/busybox poweroff -f
