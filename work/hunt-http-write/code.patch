diff --git a/api/hunt/replay_authority.py b/api/hunt/replay_authority.py
new file mode 100644
index 0000000..67506ad
--- /dev/null
+++ b/api/hunt/replay_authority.py
@@ -0,0 +1,22 @@
+"""Keep active and safe Hunt replay distinct through admission and execution."""
+from __future__ import annotations
+
+from typing import Any, Mapping
+from scanner_tools.request_replay import ReplayAuthorization
+
+
+def replay_authorization(capability: str, policy: Mapping[str, Any], selection_policy: str) -> ReplayAuthorization:
+    if capability == "collections.replay_safe":
+        # A confirmed-active selection does not turn the safe capability into writes.
+        return ReplayAuthorization()
+    if capability != "collections.replay_active":
+        raise ValueError("Unknown Hunt collection replay capability")
+    if capability not in (policy.get("allowed_capabilities") or ()):
+        raise ValueError("Active replay is outside the persisted Hunt capability contract")
+    if selection_policy != "confirmed_active":
+        raise ValueError("Active replay requires a saved confirmed-active collection selection")
+    if not (policy.get("active_testing") is True and policy.get("allow_state_changing_http") is True
+            and policy.get("approval_receipt_id")):
+        raise ValueError("Active replay requires the Hunt's authorized state-changing HTTP policy")
+    return ReplayAuthorization(active_testing=True, allow_state_changing_http=True,
+                               approval_receipt_id=str(policy["approval_receipt_id"]))
