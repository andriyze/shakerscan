new file mode 100644
index 0000000..7cfcfd8
--- /dev/null
+++ b/api/capabilities/hunt_http_identity.py
@@ -0,0 +1,53 @@
+"""Resolve one HTTP Hunt identity in the worker, before any target traffic."""
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from runtime.credential_refs import CredentialReferenceError, select_hunt_principal_reference
+from runtime.credential_resolver import (
+    CredentialResolutionError, WorkerCredentialResolver, validate_worker_credential_authority,
+)
+
+
+async def resolve_http_identity(*, pool: Any, stack: Any, session_store: Any,
+                                hunt_id: Any, target: Any, policy: Any,
+                                context: Mapping[str, Any], capability_name: str,
+                                capability_input: Mapping[str, Any]):
+    """Return worker-private (session, headers, principal); never widen a profile."""
+    import urllib.parse
+    session_ref = capability_input.get("session_ref")
+    principal = str(capability_input.get("as_principal") or "anonymous").strip().lower()
+    if session_ref and principal not in {"", "anonymous", "anon", "none"}:
+        raise CredentialReferenceError("HTTP request accepts either session_ref or as_principal, not both")
+    if not session_ref and principal in {"", "anonymous", "anon", "none"}:
+        return None, {}, "anonymous"
+    conn = await stack.enter_async_context(pool.acquire())
+    authority = await validate_worker_credential_authority(
+        conn, owner_kind="hunt", owner_id=str(hunt_id), target=target,
+        approval_receipt_id=policy.approval_receipt_id, scope_receipt_id=target.scope_receipt_id,
+        action_name=f"hunt.capability:{capability_name}",
+    )
+    if session_ref:
+        origin = capability_input.get("origin") or target.allowed_origins[0]
+        session = await session_store.load_for_worker(
+            conn, session_ref=session_ref, owner_kind="hunt", owner_id=hunt_id,
+            target=target, capability=capability_name,
+            selected_origins=(urllib.parse.urlunsplit(
+                (*urllib.parse.urlsplit(origin)[:2], "", "", ""),
+            ),),
+        )
+        return session, session.headers(), session.metadata.principal_slot
+    ref = select_hunt_principal_reference(context, principal, capability=capability_name)
+    matches = [item for item in context.get("credential_refs") or ()
+               if isinstance(item, Mapping) and item.get("profile_id") == ref["profile_id"]
+               and item.get("principal_slot") == ref["principal_slot"]]
+    if len(matches) != 1:
+        raise CredentialReferenceError("managed Hunt principal context is missing or ambiguous")
+    resolved = await stack.enter_async_context(WorkerCredentialResolver().resolve(
+        conn, profile_id=ref["profile_id"], target=target,
+        capability=capability_name, authority=authority,
+    ))
+    if (resolved.profile.current_version != ref["profile_version"]
+            or resolved.profile.principal_slot != principal):
+        raise CredentialResolutionError("managed Hunt principal changed after admission")
+    return None, resolved.http_headers().as_dict(), principal
