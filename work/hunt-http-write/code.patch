diff --git a/api/runtime/http_action_contract.py b/api/runtime/http_action_contract.py
new file mode 100644
index 0000000..454b355
--- /dev/null
+++ b/api/runtime/http_action_contract.py
@@ -0,0 +1,50 @@
+"""Shared input and authority contract for operator-authorized HTTP writes.
+
+Transport and receipts stay in the existing HTTP worker. These helpers never
+infer authorization from a method, objective, body, or model name.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Mapping
+
+HTTP_WRITE_CAPABILITY = "http.request_active"
+HTTP_WRITE_METHODS = ("POST", "PUT", "PATCH", "DELETE")
+HTTP_BODY_FIELDS = ("json_body", "form_body", "raw_body")
+MAX_HTTP_WRITE_BODY_BYTES = 32_768
+
+
+def validate_http_write_input(value: Mapping[str, Any]) -> None:
+    """Reject ambiguous bodies before admission, not after reserving traffic."""
+    fields = [key for key in HTTP_BODY_FIELDS if key in value]
+    if len(fields) > 1:
+        raise ValueError("HTTP request accepts only one of json_body, form_body, raw_body")
+    if value.get("follow_redirects") is True:
+        raise ValueError("Write requests return redirects without following or repeating the write")
+    if fields:
+        body = value[fields[0]]
+        encoded = body.encode("utf-8") if isinstance(body, str) else json.dumps(
+            body, ensure_ascii=False, allow_nan=False, separators=(",", ":"),
+        ).encode("utf-8")
+        if len(encoded) > MAX_HTTP_WRITE_BODY_BYTES:
+            raise ValueError("HTTP request body exceeds the 32768-byte limit")
+
+
+def require_http_write_authority(policy: Mapping[str, Any]) -> None:
+    """Use saved run authority; receipt validity is rechecked by normal dispatch."""
+    if not (policy.get("active_testing") is True
+            and policy.get("allow_state_changing_http") is True
+            and policy.get("approval_receipt_id")):
+        raise ValueError("http.request_active requires the Hunt's authorized state-changing HTTP policy")
+
+
+def redact_http_write_body(value: Mapping[str, Any]) -> dict[str, Any]:
+    """Never persist raw request-body values in planner/audit summaries."""
+    result = dict(value)
+    for key in HTTP_BODY_FIELDS:
+        if key in result:
+            body = result.pop(key)
+            result[key + "_present"] = True
+            if isinstance(body, Mapping):
+                result[key + "_field_names"] = sorted(str(name)[:200] for name in body)[:256]
+    return result
