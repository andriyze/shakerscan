        {"id":"mcp","label":"MCP authorization checks","pytest_selector":"tests/test_ai_gate_judging.py::test_mcp_oauth_audience_confusion_is_detected"},
        {"id":"widget","label":"Widget request budgets","pytest_selector":"tests/test_ai_gate_judging.py::test_widget_target_blocks_request_when_budget_is_exhausted"}
