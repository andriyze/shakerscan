        {"id":"revocation","label":"Revoked and expired approval rejection","pytest_selector":"tests/test_model_intake_admission.py::test_admission_rejects_tampering_drift_and_expiry"},
        {"id":"report","label":"Deterministic report rebuild","pytest_selector":"tests/test_model_intake_reporting.py::test_report_digest_is_content_stable_across_render_times"},
