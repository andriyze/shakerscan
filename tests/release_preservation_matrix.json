        {"id":"onnx","label":"ONNX format","pytest_selector":"tests/test_model_intake_loader_runner.py::test_onnx_profile_uses_hash_locked_cpu_runtime_for_hugging_face_families"},
        {"id":"pytorch","label":"PyTorch conversion boundary","pytest_selector":"tests/test_model_intake_loader_runner.py::test_conversion_profile_is_narrow_digest_bound_and_model_agnostic"},
        {"id":"legacy_transformers","label":"Legacy Transformers initialization","pytest_selector":"tests/test_model_intake_loader_runner.py::test_guest_installs_bounded_transformers_compatibility_defaults"},
        {"id":"archive","label":"Local archive format","pytest_selector":"tests/test_model_intake_archives.py::test_complete_archive_path_detects_risky_model_configuration"},
        {"id":"provider_acquisition","label":"URL and Hugging Face acquisition","pytest_selector":"tests/test_model_intake.py::test_model_intake_fetches_huggingface_resolve_url"}
