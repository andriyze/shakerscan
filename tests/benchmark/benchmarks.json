{
  "global_assertions": {
    "min_high_precision": 0.9,
    "min_critical_precision": 0.95,
    "max_unverified_high_ratio": 0.1
  },
  "benchmarks": [
    {
      "name": "juice-shop",
      "target_url": "http://host.docker.internal:3001",
      "result_path": "tests/benchmark/results/juice-shop/latest.json",
      "scan_options": {
        "scan_type": "smart",
        "budget_profile": "balanced"
      },
      "assertions": {
        "min_total_findings": 10,
        "min_high_or_critical": 2,
        "min_high_precision": 0.9,
        "min_quality_score": 60,
        "min_endpoint_coverage": 0.05,
        "min_har_api_requests": 5,
        "min_har_unique_endpoints": 10,
        "max_unverified_high_ratio": 0.1,
        "min_expected_recall": 0.5,
        "require_methods_used": [
          "browser_api_capture"
        ],
        "require_any_finding_tools": [
          "smart_sqli",
          "nosql_injection",
          "dom_xss"
        ],
        "expected_findings": [
          {
            "tool": "smart_sqli",
            "title_contains": "SQL Injection",
            "min_severity": "high",
