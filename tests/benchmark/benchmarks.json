          },
          {
            "tool": "active_xss",
            "title_contains": "XSS",
            "min_severity": "high",
            "verified": true
          },
          {
            "tool": "dom_xss",
            "title_contains": "DOM-Based XSS"
          },
          {
            "tool": "api_security",
            "title_contains": "Sensitive data"
          }
        ]
      }
    },
    {
      "name": "crapi",
      "result_path": "tests/benchmark/results/crapi/latest.json",
      "allow_missing_har": true,
      "assertions": {
        "min_total_findings": 5,
