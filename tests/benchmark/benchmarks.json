        "min_quality_score": 50,
        "min_endpoint_coverage": 0.05,
        "max_unverified_high_ratio": 0.1,
        "min_expected_recall": 0.5,
        "expected_findings": [
          {
            "tool": "exposed_files",
            "title_contains": ".env",
            "min_severity": "high"
          },
          {
            "tool": "api_security",
            "title_contains": "Sensitive data"
          }
        ]
      }
    }
  ]
