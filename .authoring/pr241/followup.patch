+def public_workflow_result(result: Mapping[str, Any], *, sealed_response: bool = True, header_values: tuple[str, ...] = ()) -> dict[str, Any]:
+    """Private exchanges expose measurements, never heuristic secret previews.
+
+    A pairing credential may have any field name, be numeric, or be echoed in
+    response headers/redirects. Unkeyed body hashes also expose short PINs to
+    guessing. Raw exchanges remain in the existing sensitive archive; ordinary
+    HTTP requests without private material keep their normal observations.
+    """
+    result = dict(result)
+    if not sealed_response:
+        # Authenticated reads remain useful: conceal known header material and
+        # literal/URL-encoded echoes without hiding unrelated response evidence.
+        needles = sorted({part for value in header_values for part in (value, quote(value, safe=""), json.dumps(value)[1:-1]) if part}, key=len, reverse=True)
+        def clean(value):
+            if isinstance(value, dict):
+                return {clean(key): clean(item) for key, item in value.items()}
+            if isinstance(value, list):
+                return [clean(item) for item in value]
+            if isinstance(value, str):
+                for needle in needles:
+                    value = value.replace(needle, "<redacted>")
+            return value
+        result = clean(result)
+        if isinstance(result.get("response"), dict):
+            result["response"].pop("body_sha256", None)
+            result["response"].pop("body_digest_scope", None)
+        return result
+    response = result.get("response")
+    if isinstance(response, Mapping):
+        measured = {key: response[key] for key in (
+            "status", "content_length", "content_length_header", "bytes_observed",
+            "content_semantically_populated", "truncated", "elapsed_ms", "set_cookie_metadata",
+        ) if key in response}
+        measured.update(body_values_visible=False, response_values_private=True)
+        result["response"] = measured
+    if isinstance(result.get("redirect_chain"), list):
+        result["redirect_chain"] = [
+            {key: hop[key] for key in ("status", "followed", "stopped") if key in hop}
+            for hop in result["redirect_chain"] if isinstance(hop, Mapping)
+        ]
+    return result
 
 
