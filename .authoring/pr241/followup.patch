+@pytest.mark.parametrize('capability,method', [('collections.replay_active', 'PUT'), ('collections.replay_safe', 'GET')])
+def test_replay_narrows_before_applying_per_call_limit(capability, method):
+    collection = {'id': uuid.uuid4(), 'payload_sha256': 'a' * 64}
+    ref = {'collection_id': str(collection['id']), 'selection_id': str(uuid.uuid4()),
+           'replay_policy': 'confirmed_active', 'selector': {'safe_methods_only': False, 'max_requests': 100}}
+    rows = [{'request_id': f'r{i}', 'ordinal': i, 'method': method, 'safe_method': method == 'GET',
+             'normalized_path': f'/r{i}', 'supported': True} for i in range(100)]
+    queued = []
+    class DB:
+        @asynccontextmanager
+        async def acquire(self): yield self
+        async def fetch(self, *_): return rows
+        def hset(self, *_, **__): pass
+        def expire(self, *_): pass
+        def delete(self, *_): pass
+        def get(self, *_): return json.dumps({'status': 'success'})
+    db = DB()
+    async def bound(*_): return collection, ref
+    async def record(*_): pass
+    source = Path('api/hunt/interaction_router.py').read_text()
+    functions = [node for node in ast.parse(source).body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name in {'_enqueue_hunt_replay_capability', '_hunt_collection_selector', '_hunt_bound_selector'}]
+    assert len(functions) == 3
+    namespace = {**globals(), '_pool': lambda: db, '_get': lambda _: 'queue', 'get_redis': lambda: db,
+        '_hunt_bound_collection': bound, '_hunt_managed_principal_reference': lambda *_, **__: None,
+        'record_cancellable_job_durable': record, 'utc_now_iso': lambda: '2026-09-28T00:00:00Z',
+        'enqueue_job': lambda _db, _name, payload: queued.append(payload),
+        '_select_request_collection_index_rows': select_request_collection_index_rows}
+    exec(compile(ast.fix_missing_locations(ast.Module(body=functions, type_ignores=[])), '<real enqueue>', 'exec'), namespace)
+    result = asyncio.run(namespace['_enqueue_hunt_replay_capability'](
+        {'id': uuid.uuid4()}, {}, {'collection_id': str(collection['id']), 'request_ids': ['r75'], 'limit': 1},
+        action_id=uuid.uuid4(), action_digest='b' * 64, capability_name=capability))
+    assert result['status'] == 'success'
+    assert len(queued) == 1 and queued[0]['selector']['request_ids'] == ['r75']
+    assert queued[0]['capability_name'] == capability and queued[0]['selector']['limit'] == 1
