diff --git a/skills/web/37-managed-ssh-authentication-and-host-review.md b/skills/web/37-managed-ssh-authentication-and-host-review.md
index 72aef72c89df6d445903bae1a5059a08726c3873..0b05d07c92db6db290c6725a70d59638d85d416e 100644
--- a/skills/web/37-managed-ssh-authentication-and-host-review.md
