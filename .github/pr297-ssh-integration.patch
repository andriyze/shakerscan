diff --git a/.github/workflows/hunt-ssh-acceptance.yml b/.github/workflows/hunt-ssh-acceptance.yml
new file mode 100644
index 0000000000000000000000000000000000000000..11a293691dae6cd7c10f09befc9b75a4c54b1cab
--- /dev/null
+++ b/.github/workflows/hunt-ssh-acceptance.yml
@@ -0,0 +1,75 @@
+name: Hunt direct SSH acceptance
+
+on:
+  pull_request:
+  merge_group:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: hunt-ssh-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  ssh-runtime:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    services:
+      postgres:
+        image: postgres:18
+        env:
+          POSTGRES_PASSWORD: ssh-ci-only
+          POSTGRES_DB: hunt_ssh_test
+        ports: ['5432:5432']
+        options: >-
+          --health-cmd "pg_isready -U postgres -d hunt_ssh_test"
+          --health-interval 5s --health-timeout 5s --health-retries 10
+      redis:
+        image: redis:7-alpine
+        ports: ['6379:6379']
+        options: >-
+          --health-cmd "redis-cli ping" --health-interval 5s
+          --health-timeout 5s --health-retries 10
+    env:
+      TARGET_ASSET_TEST_DATABASE_URL: postgresql://postgres:ssh-ci-only@127.0.0.1:5432/hunt_ssh_test
+      SSH_TEST_REDIS_URL: redis://127.0.0.1:6379/15
+      SSH_TIMING_OUTPUT_DIR: artifacts/ssh-timings
+      PYTHONPATH: .:api:scanner
+    steps:
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1
+        with:
+          python-version: '3.12'
+      - run: python -m pip install --require-hashes -r scanner/requirements.lock
+      - name: Exercise actual command processes through Hunt and its production worker
+        run: |
+          mkdir -p artifacts
+          python -m pytest -q tests/test_hunt_ssh_commands.py tests/test_api_stream.py tests/test_target_asset_ssh_runtime_postgres.py --junitxml=artifacts/ssh-runtime.xml
+          python - <<'PY'
+          import xml.etree.ElementTree as ET
+          suites=ET.parse('artifacts/ssh-runtime.xml').findall('testsuite')
+          assert sum(int(s.get('tests','0')) for s in suites)>=30
+          assert sum(int(s.get('skipped','0')) for s in suites)==0
+          PY
+      - name: Verify installed and public contracts
+        run: |
+          python scripts/generate_capability_inventory.py --check
+          python scripts/generate_hunt_contract.py --check
+          python scripts/generate_public_api_contract.py --check
+          python scripts/generate_install_manifest.py --check
+          python scripts/check_installed_import_closure.py
+          python scripts/check_module_size.py
+          python scripts/check_documentation_policy.py
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        if: always()
+        with:
+          name: hunt-ssh-runtime-${{ github.sha }}
+          path: |
+            artifacts/ssh-runtime.xml
+            artifacts/ssh-timings
+          retention-days: 7
+          if-no-files-found: error
