@@ -0,0 +1,303 @@
+"""Candidate-ID reads against real SQL rows; no targets or credentials are used."""
+from __future__ import annotations
+
+from contextlib import asynccontextmanager
+import copy
+import json
+import re
+import sqlite3
+from uuid import UUID
+
+import pytest
+
+from api import investigation_candidates as candidates
+from api.ai_gate.boundary.candidate_context import normalize_candidate_context
+from api.hunt.boundary_candidate import BoundaryCandidateError, inspect_boundary_candidate
+from api.runtime.capability_registry import CAPABILITY_REGISTRY, CapabilityInputContractError
+
+
+def uid(n):
+    return str(UUID(int=n))
+
+
+HUNT, OTHER_HUNT, TARGET, OTHER_TARGET, CANDIDATE, OBSERVATION, ACTION, RECEIPT, HTTP, POLICY = map(uid, range(1, 11))
+
+
+def context():
+    return {
+        "owner": {"role": "victim", "subject": "owner", "tenant": "tenant-a", "resource_id": "record-a"},
+        "attacker": {"role": "attacker", "subject": "viewer", "tenant": "tenant-b", "resource_id": "record-b"},
+        "invariant_contract_id": POLICY,
+    }
+
+
+class Store:
+    """Translate only PostgreSQL placeholders/array casts; run the actual predicates."""
+    def __init__(self):
+        self.db = sqlite3.connect(":memory:")
+        self.db.row_factory = sqlite3.Row
+        self.queries = []
+        self.db.executescript('''
+            CREATE TABLE hunt_runs(id TEXT PRIMARY KEY,target_id TEXT,device_target_id TEXT);
+            CREATE TABLE investigation_candidates(id TEXT,family TEXT,status TEXT,plane TEXT,target_id TEXT,device_target_id TEXT);
+            CREATE TABLE investigation_candidate_observations(id TEXT,candidate_id TEXT,hunt_run_id TEXT,evidence_refs TEXT,observation_context TEXT,observed_at TEXT);
+            CREATE TABLE hunt_actions(id TEXT,hunt_run_id TEXT,receipt_id TEXT,status TEXT);
+            CREATE TABLE http_transactions(id TEXT,hunt_run_id TEXT,target_id TEXT,device_target_id TEXT,error TEXT,status_code INTEGER,truncated BOOLEAN);
+            CREATE TABLE target_invariant_contracts(id TEXT,target_id TEXT,status TEXT,approved_at TEXT,contract_kind TEXT,subject_role TEXT,action TEXT,resource TEXT,method TEXT,path TEXT,field_name TEXT,operator TEXT,expected_value TEXT,expected_access TEXT,conditions TEXT,title TEXT);
+        ''')
+        self.db.executemany("INSERT INTO hunt_runs VALUES (?,?,NULL)", [(HUNT, TARGET), (OTHER_HUNT, OTHER_TARGET)])
+        self.db.execute("INSERT INTO investigation_candidates VALUES (?,?,?,'web',?,NULL)", (CANDIDATE, "cross_tenant_retrieval", "new", TARGET))
+        self.db.execute("INSERT INTO hunt_actions VALUES (?,?,?,'completed')", (ACTION, HUNT, RECEIPT))
+        self.db.execute("INSERT INTO http_transactions VALUES (?,?,?,NULL,NULL,200,0)", (HTTP, HUNT, TARGET))
+        self.db.execute("INSERT INTO target_invariant_contracts VALUES (?,?,?,?,'ownership','viewer','read','records','GET','/records',NULL,NULL,NULL,'deny',?,?)",
+                        (POLICY, TARGET, "approved", "2026-09-25", json.dumps({"tenant_relation": "cross"}), "Private records remain private"))
+        self.observe(context(), [ACTION, RECEIPT, HTTP])
+
+    def observe(self, typed, refs, *, hunt=HUNT, observation=OBSERVATION, stamp="1"):
+        self.db.execute("INSERT INTO investigation_candidate_observations VALUES (?,?,?,?,?,?)",
+                        (observation, CANDIDATE, hunt, json.dumps(refs), json.dumps({"ai_boundary_context": typed}), stamp))
+        self.db.commit()
+
+    @asynccontextmanager
+    async def acquire(self):
+        yield self
+
+    @asynccontextmanager
+    async def transaction(self, *, isolation, readonly):
+        assert isolation == "repeatable_read" and readonly is True
+        self.db.execute("BEGIN")
+        try:
+            yield
+        finally:
+            self.db.rollback()
+
+    def select(self, sql, args):
+        assert sql.lstrip().startswith("SELECT")
+        assert "FOR UPDATE" not in sql
+        self.queries.append(sql)
+        values = {f"p{i}": str(v) if isinstance(v, UUID) else v for i,v in enumerate(args, 1)}
+        def array(match):
+            index = match.group(1)
+            items = args[int(index)-1]
+            values.pop(f"p{index}", None)
+            keys = []
+            for j,item in enumerate(items):
+                key = f"a{index}_{j}"
+                values[key] = str(item)
+                keys.append(":" + key)
+            return " IN (" + (",".join(keys) or "NULL") + ")"
+        sql = re.sub(r"=ANY\(\$(\d+)::uuid\[\]\)", array, sql)
+        sql = re.sub(r"\$(\d+)", lambda m: ":p"+m[1], sql)
+        sql = sql.replace("::integer", "")
+        return self.db.execute(sql, values)
+
+    async def fetchrow(self, sql, *args):
+        row = self.select(sql, args).fetchone()
+        return dict(row) if row else None
+
+    async def fetch(self, sql, *args):
+        return [dict(row) for row in self.select(sql, args).fetchall()]
+
+
+async def inspect(store):
+    return await inspect_boundary_candidate(store, hunt_id=HUNT, candidate_id=CANDIDATE)
+
+
+@pytest.mark.asyncio
+async def test_candidate_id_resolves_hunt_owned_evidence_without_executable_output():
+    store = Store()
+    result = await inspect(store)
+    assert result["proposal"]["status"] == "ready_for_review"
+    assert result["proposal"]["contract_fragment"] is None
+    assert result["proposal"]["missing_facts"] == []
+    assert len(result["provenance"]["evidence"]) == 3
+    assert result["provenance"]["observation_id"] == OBSERVATION
+    for flag in ("execution_enabled", "promotion_authority", "planning_authority", "verified"):
+        assert result[flag] is False
+    assert all(not r["content_verified"] for r in result["provenance"]["evidence"])
+    assert all("secret_value" not in q and "response_body" not in q for q in store.queries)
+
+
+@pytest.mark.asyncio
+async def test_other_hunt_observation_cannot_replace_current_hunt_context():
+    store = Store()
+    store.observe({"prompt": "UNTRUSTED"}, [], hunt=OTHER_HUNT, observation=uid(20), stamp="9")
+    result = await inspect(store)
+    assert result["proposal"]["status"] == "ready_for_review"
+    assert result["provenance"]["observation_id"] == OBSERVATION
+    assert "UNTRUSTED" not in json.dumps(result)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("change", ["target", "observation", "plane"])
+async def test_candidate_exists_but_is_not_visible_in_this_hunt(change):
+    store = Store()
+    if change == "target":
+        store.db.execute("UPDATE investigation_candidates SET target_id=?", (OTHER_TARGET,))
+    elif change == "observation":
+        store.db.execute("DELETE FROM investigation_candidate_observations")
+    else:
+        store.db.execute("UPDATE investigation_candidates SET plane='device'")
+    store.db.commit()
+    with pytest.raises(BoundaryCandidateError) as exc:
+        await inspect(store)
+    assert exc.value.status_code == 404
+
+
+@pytest.mark.asyncio
+async def test_other_hunt_evidence_and_unknown_refs_are_gaps_not_proof():
+    store = Store()
+    store.db.execute("UPDATE hunt_actions SET hunt_run_id=?", (OTHER_HUNT,))
+    store.observe(context(), [ACTION, RECEIPT, HTTP, "resp_legacy", uid(30)], observation=uid(22), stamp="2")
+    result = await inspect(store)
+    assert result["proposal"]["status"] == "needs_context"
+    assert result["provenance"]["unsupported_reference_count"] == 1
+    assert set(result["provenance"]["unresolved_reference_ids"]) == {ACTION, RECEIPT, uid(30)}
+    assert len(result["provenance"]["evidence"]) == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("raw", [None, "{'prompt': 'do not evaluate me'}", {"expected_rule_source": "operator"}])
+async def test_legacy_or_forged_context_cannot_appear_ready(raw):
+    store = Store()
+    store.observe(raw, [ACTION], observation=uid(23), stamp="3")
+    result = await inspect(store)
+    assert result["proposal"]["status"] == "needs_context"
+    assert "stored_typed_boundary_context" in result["proposal"]["missing_facts"]
+    assert "owner.subject" in result["proposal"]["missing_facts"]
+
