+@pytest.mark.asyncio
+async def test_actual_hunt_inline_branch_uses_the_registered_adapter_and_receipt():
+    # Exercise the real branch body without importing optional API/DB drivers on
+    # lightweight hosts. Full FastAPI composition remains covered in normal CI.
+    import ast
+    import asyncio
+    from pathlib import Path
+    from types import SimpleNamespace
+    from fastapi import HTTPException
+    from capabilities.inline import ControlPlaneExecutionAdapter
+    from hunt.action_dispatcher import HUNT_ACTION_DISPATCHER, HuntActionRequest, RegisteredHuntAdapterFactory
+    from runtime.capability_registry import CAPABILITY_REGISTRY as runtime_registry
+    from runtime.models import TargetBinding
+
+    source = Path(__file__).parents[1] / 'api/hunt/interaction_router.py'
+    tree = ast.parse(source.read_text())
+    branch = next(n for n in ast.walk(tree) if isinstance(n, ast.If)
+                  and ast.unparse(n.test) == "name == 'ai.boundary.candidate.inspect'")
+    fn = ast.AsyncFunctionDef(
+        name='dispatch_branch', args=ast.arguments(posonlyargs=[], args=[], kwonlyargs=[], kw_defaults=[], defaults=[]),
+        body=[*copy.deepcopy(branch.body), ast.Return(value=ast.Tuple(
+            elts=[ast.Name(id='result', ctx=ast.Load()), ast.Name(id='capability_execution', ctx=ast.Load())], ctx=ast.Load()))],
+        decorator_list=[],
+    )
+    store = Store()
+    spec = runtime_registry.require('ai.boundary.candidate.inspect')
+    target = TargetBinding(target_id=TARGET, target_kind='web', canonical_host='example.test')
+    async def dispatch(adapter, *, target, requested_budget):
+        action = HuntActionRequest(hunt_id=HUNT, action_id=uid(50), capability_name=spec.name,
+                                   target=target, capability_input={'candidate_id': CANDIDATE}, requested_budget=requested_budget)
+        result = await HUNT_ACTION_DISPATCHER.execute(action, RegisteredHuntAdapterFactory(
+            {spec.adapter: lambda _spec, _request: adapter}), heartbeat=lambda: asyncio.sleep(0), cancelled=lambda: False)
+        return result
+    namespace = {
+        '__package__': 'api.hunt', 'Any': object, 'HTTPException': HTTPException,
+        'run': {'id': HUNT}, 'request': SimpleNamespace(input={'candidate_id': CANDIDATE}),
+        'spec': spec, '_pool': lambda: store, 'ControlPlaneExecutionAdapter': ControlPlaneExecutionAdapter,
+        'durable_reservation': SimpleNamespace(record=SimpleNamespace(requested={'tool_wall_seconds': 5})),
+        'inline_hunt_target_binding': lambda: target, 'dispatch_registered_adapter': dispatch,
+    }
+    exec(compile(ast.fix_missing_locations(ast.Module(body=[fn], type_ignores=[])), str(source), 'exec'), namespace)
+    result, execution = await namespace['dispatch_branch']()
+    assert result['review']['proposal']['status'] == 'ready_for_review'
+    assert execution.status == 'success'
+    assert execution.observations[0]['kind'] == 'boundary_candidate_review'
+    assert execution.observations[0]['verified'] is False
+    assert execution.actual_budget.get('http_requests', 0) == 0
