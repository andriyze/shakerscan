 diff --git a/api/hunt/boundary_candidate.py b/api/hunt/boundary_candidate.py
new file mode 100644
index 0000000..8c26b54
--- /dev/null
+++ b/api/hunt/boundary_candidate.py
@@ -0,0 +1,236 @@
+"""Read-only review of one Hunt-owned AI-boundary candidate.
+
+Only IDs cross this interface. Stored context is an unverified observation, not
+policy or proof. No target requests, credential resolution, dispatch or findings
+are performed here; a review-ready result is deliberately not materializable.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any
+from uuid import UUID
+
+try:
+    from ai_gate.boundary.candidate_context import normalize_candidate_context
+    from invariant_contracts import approval_errors, canonical_contract
+except ModuleNotFoundError:
+    from ..ai_gate.boundary.candidate_context import normalize_candidate_context
+    from ..invariant_contracts import approval_errors, canonical_contract
+
+KINDS = {
+    "cross_tenant_retrieval": "cross_tenant_read", "bola": "cross_tenant_read",
+    "forbidden_agent_action": "cross_tenant_action", "agent_action": "cross_tenant_action",
+    "approval_bypass": "approval_bypass",
+    "tool_principal_boundary": "tool_principal", "tool_boundary": "tool_principal",
+}
+ACTION_FIELDS = ("prompt", "verifier_path", "state_path", "initial_value", "forbidden_value")
+REQUIRED_FIELDS = {
+    "cross_tenant_read": (),
+    "cross_tenant_action": ACTION_FIELDS,
+    "approval_bypass": (*ACTION_FIELDS, "approval_path", "approval_state_path", "required_approval_value"),
+    "tool_principal": ("prompt", "tool_name", "expected_principal", "tool_calls_path",
+                       "tool_name_field", "executed_field", "principal_field"),
+}
+MAX_EVIDENCE_REFS = 100
+
+CANDIDATE_SQL = """
+SELECT c.id, c.family, c.status, c.plane, c.target_id, c.device_target_id,
+       o.id AS observation_id, o.hunt_run_id AS observation_hunt_id,
+       o.evidence_refs, o.observation_context
+FROM investigation_candidates c
+JOIN investigation_candidate_observations o
+    ON o.candidate_id=c.id AND o.hunt_run_id=$2
+WHERE c.id=$1 AND (
+    (c.plane='web' AND c.target_id=$3 AND c.device_target_id IS NULL) OR
+    (c.plane='device' AND c.device_target_id=$4 AND c.target_id IS NULL)
+)
+ORDER BY o.observed_at DESC, o.id DESC LIMIT 1
+"""
+EVIDENCE_SQL = """
+SELECT id AS reference_id, 'action' AS kind, status, NULL::integer AS status_code,
+       false AS truncated
+FROM hunt_actions WHERE hunt_run_id=$1 AND id=ANY($2::uuid[])
+UNION ALL
+SELECT receipt_id AS reference_id, 'receipt_link' AS kind, status,
+       NULL::integer AS status_code, false AS truncated
+FROM hunt_actions WHERE hunt_run_id=$1 AND receipt_id=ANY($2::uuid[])
+UNION ALL
+SELECT id AS reference_id, 'http_transaction' AS kind,
+       CASE WHEN error IS NULL THEN 'recorded' ELSE 'error' END AS status,
+       status_code, truncated
+FROM http_transactions WHERE hunt_run_id=$1 AND id=ANY($2::uuid[]) AND (
+    (target_id=$3 AND device_target_id IS NULL) OR
+    (device_target_id=$4 AND target_id IS NULL)
+)
+"""
+
+
+class BoundaryCandidateError(ValueError):
+    def __init__(self, code: str, status_code: int = 422) -> None:
+        super().__init__(code)
+        self.status_code = status_code
+
+
+def _uuid(value: Any) -> UUID:
+    try:
+        return UUID(str(value))
+    except (ValueError, TypeError, AttributeError) as exc:
+        raise BoundaryCandidateError("invalid_candidate_review_reference") from exc
+
+
+def _json(value: Any, expected: type) -> Any:
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except (ValueError, TypeError):
+            return expected()
+    return value if isinstance(value, expected) else expected()
+
+
+def _digest(value: Any) -> str:
+    return "sha256:" + hashlib.sha256(json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
+        allow_nan=False,
+    ).encode()).hexdigest()
+
+
+async def inspect_boundary_candidate(pool: Any, *, hunt_id: str, candidate_id: str) -> dict[str, Any]:
+    """Resolve current-Hunt evidence metadata in one read-only consistent snapshot."""
+    hunt_uuid, candidate_uuid = _uuid(hunt_id), _uuid(candidate_id)
+    async with pool.acquire() as conn:
+        async with conn.transaction(isolation="repeatable_read", readonly=True):
+            run_row = await conn.fetchrow(
+                "SELECT id,target_id,device_target_id FROM hunt_runs WHERE id=$1", hunt_uuid,
+            )
+            if not run_row:
+                raise BoundaryCandidateError("hunt_not_found", 404)
+            run = dict(run_row)
+            if bool(run.get("target_id")) == bool(run.get("device_target_id")):
+                raise BoundaryCandidateError("hunt_asset_binding_unavailable", 409)
+            row = await conn.fetchrow(CANDIDATE_SQL, candidate_uuid, hunt_uuid,
+                                      run.get("target_id"), run.get("device_target_id"))
+            if not row:
+                # Do not reveal whether the candidate exists on another Hunt/asset.
+                raise BoundaryCandidateError("candidate_not_found_for_hunt", 404)
+            candidate = dict(row)
+            if (str(candidate["id"]) != str(candidate_uuid)
+                    or str(candidate["observation_hunt_id"]) != str(hunt_uuid)
+                    or candidate.get("target_id") != run.get("target_id")
+                    or candidate.get("device_target_id") != run.get("device_target_id")):
+                raise BoundaryCandidateError("candidate_not_found_for_hunt", 404)
+            refs = _json(candidate.get("evidence_refs"), list)
+            if len(refs) > MAX_EVIDENCE_REFS:
+                raise BoundaryCandidateError("candidate_evidence_reference_limit", 409)
+            reference_ids: list[UUID] = []
+            unsupported_count = 0
+            for ref in refs:
+                try:
+                    ref_uuid = _uuid(ref)
+                except BoundaryCandidateError:
+                    unsupported_count += 1
+                    continue
+                if ref_uuid not in reference_ids:
+                    reference_ids.append(ref_uuid)
+            records = await conn.fetch(EVIDENCE_SQL, hunt_uuid, reference_ids,
+                                       run.get("target_id"), run.get("device_target_id")) if reference_ids else []
+            evidence = [dict(record) for record in records]
+            observation = _json(candidate.get("observation_context"), dict)
+            raw_context = observation.get("ai_boundary_context")
+            try:
+                context = normalize_candidate_context(raw_context)
+                context_valid = True
+            except ValueError:
+                # No fallback to the shared row or evaluation of legacy repr strings.
+                context, context_valid = {}, False
+            policy = None
+            if context.get("invariant_contract_id") and run.get("target_id"):
+                policy_row = await conn.fetchrow(
+                    "SELECT id,target_id,status,approved_at,contract_kind,subject_role,action,resource,"
+                    "method,path,field_name,operator,expected_value,expected_access,conditions,title "
+                    "FROM target_invariant_contracts WHERE id=$1 AND target_id=$2",
+                    _uuid(context["invariant_contract_id"]), run["target_id"],
+                )
+                policy = dict(policy_row) if policy_row else None
+    return _review(hunt_uuid, candidate, context, context_valid, reference_ids,
+                   unsupported_count, evidence, policy)
+
+
+def _review(hunt_id: UUID, candidate: dict[str, Any], context: dict[str, Any],
+            context_valid: bool, reference_ids: list[UUID], unsupported_count: int,
+            evidence: list[dict[str, Any]], policy: dict[str, Any] | None) -> dict[str, Any]:
+    missing: list[str] = []
+    kind = KINDS.get(str(candidate.get("family") or ""))
+    if not kind:
+        missing.append("supported_boundary_family")
+    if not context_valid:
+        missing.append("stored_typed_boundary_context")
+    for slot in ("owner", "attacker"):
+        identity = context.get(slot) or {}
+        missing.extend(f"{slot}.{field}" for field in ("role", "subject", "tenant", "resource_id")
+                       if not identity.get(field))
+    if all(context.get(slot) for slot in ("owner", "attacker")):
+        if any(context["owner"].get(field) == context["attacker"].get(field)
+               for field in ("role", "subject", "tenant", "resource_id")):
+            missing.append("distinct_control_principals_for_current_verifier")
+    missing.extend(field for field in REQUIRED_FIELDS.get(kind, ()) if field not in context)
+    if kind == "tool_principal" and "verifier_path" in context:
+        missing.extend(field for field in ("state_path", "initial_value", "forbidden_value")
+                       if field not in context)
+    if "initial_value" in context and "forbidden_value" in context:
+        if context["initial_value"] == context["forbidden_value"]:
+            missing.append("distinct_initial_and_forbidden_values")
+    found = {str(record["reference_id"]) for record in evidence}
+    unresolved = [str(ref) for ref in reference_ids if str(ref) not in found]
+    if not reference_ids:
+        missing.append("stored_resolvable_evidence")
+    if unresolved or unsupported_count:
+        missing.append("evidence_reference_resolution")
+    if any(record["status"] not in {"completed", "recorded"} or record.get("truncated")
+           for record in evidence):
+        missing.append("complete_evidence_observation")
+    policy_summary = None
+    if policy:
+        try:
+            policy["conditions"] = _json(policy.get("conditions"), dict)
+            valid = not approval_errors(policy)
+            canonical = canonical_contract(policy)
+            canonical.pop("source_text", None)
+            canonical.pop("title", None)
+        except (ValueError, TypeError):
+            valid, canonical = False, {}
+        if policy.get("status") == "approved" and policy.get("approved_at") and valid:
+            policy_summary = {"id": str(policy["id"]), "status": "approved",
+                              "contract_sha256": _digest(canonical), "binding_review_required": True}
+    if not policy_summary:
+        missing.append("approved_target_invariant_reference")
+    if candidate.get("status") == "expired":
+        missing.append("nonexpired_candidate")
+    return {
+        "schema_version": "hunt-boundary-candidate-review/v1",
+        "hunt_id": str(hunt_id), "candidate_id": str(candidate["id"]),
+        "candidate_status": candidate["status"],
+        "proposal": {
+            "schema_version": "boundary-review-proposal/v1", "kind": kind,
+            "status": "needs_context" if missing else "ready_for_review",
+            "missing_facts": list(dict.fromkeys(missing)),
+            "known_fields": sorted(context), "context_sha256": _digest(context) if context_valid else None,
+            "policy": policy_summary, "contract_fragment": None,
+        },
+        "provenance": {
+            "observation_id": str(candidate["observation_id"]),
+            "evidence": [{**record, "reference_id": str(record["reference_id"]),
+                          "content_verified": False} for record in evidence],
+            "unresolved_reference_ids": unresolved, "unsupported_reference_count": unsupported_count,
+            "truncated": False,
+        },
+        "execution_enabled": False, "planning_authority": False,
+        "promotion_authority": False, "verified": False,
+        "limitations": [
+            "Stored facts and evidence linkage are not authorization or vulnerability proof.",
+            "Review readiness does not establish policy applicability or live fixture ownership.",
+            "Receipt references are resolved as links; receipt content is not revalidated here.",
+            "Only UUID references to this Hunt's actions, receipt links and HTTP records are resolved.",
+            "No credentials, raw evidence bodies, prompts or executable contracts are returned.",
+        ],
+    }
