index 0000000..da5ac6c
--- /dev/null
+++ b/api/ai_gate/boundary/candidate_context.py
@@ -0,0 +1,57 @@
+"""Bounded typed context on an unverified candidate, never execution authority."""
+from __future__ import annotations
+
+import copy
+import json
+import math
+import re
+from typing import Any
+from uuid import UUID
+
+TEXT_FIELDS = frozenset({
+    "verifier_path", "state_path", "approval_path", "approval_state_path",
+    "tool_name", "expected_principal", "prompt", "tool_calls_path",
+    "tool_name_field", "executed_field", "principal_field",
+})
+VALUE_FIELDS = frozenset({"initial_value", "forbidden_value", "required_approval_value"})
+IDENTITY_FIELDS = frozenset({"role", "subject", "tenant", "resource_id"})
+ALLOWED_FIELDS = TEXT_FIELDS | VALUE_FIELDS | {"owner", "attacker", "invariant_contract_id"}
+MAX_CONTEXT_BYTES = 16384
+
+
+def normalize_candidate_context(value: Any) -> dict[str, Any]:
+    """Preserve JSON types without accepting credentials, policy prose or extra keys.
+
+    Older PR builds stored Python repr strings. Do not evaluate or guess through
+    those strings: read-side callers report an unavailable context instead.
+    """
+    if not isinstance(value, dict) or set(value) - ALLOWED_FIELDS:
+        raise ValueError("invalid_ai_boundary_context_fields")
+    result: dict[str, Any] = {}
+    for key, item in value.items():
+        if key in {"owner", "attacker"}:
+            if not isinstance(item, dict) or set(item) - IDENTITY_FIELDS:
+                raise ValueError("invalid_ai_boundary_context_identity")
+            if any(not isinstance(v, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", v)
+                   for v in item.values()):
+                raise ValueError("invalid_ai_boundary_context_identity")
+        elif key == "invariant_contract_id":
+            try:
+                item = str(UUID(str(item)))
+            except (TypeError, ValueError, AttributeError) as exc:
+                raise ValueError("invalid_ai_boundary_context_invariant") from exc
+        elif key in TEXT_FIELDS:
+            if not isinstance(item, str) or not item.strip() or len(item) > 2000:
+                raise ValueError("invalid_ai_boundary_context_text")
+        elif item is not None and type(item) not in {str, int, float, bool}:
+            raise ValueError("ai_boundary_context_requires_scalar_state_values")
+        if isinstance(item, float) and not math.isfinite(item):
+            raise ValueError("invalid_ai_boundary_context_number")
+        result[key] = copy.deepcopy(item)
+    try:
+        encoded = json.dumps(result, ensure_ascii=False, allow_nan=False).encode("utf-8")
+    except (ValueError, TypeError, UnicodeError) as exc:
+        raise ValueError("invalid_ai_boundary_context_json") from exc
+    if len(encoded) > MAX_CONTEXT_BYTES:
+        raise ValueError("ai_boundary_context_too_large")
+    return result
